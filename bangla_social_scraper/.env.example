# Copy to .env and fill in. Never commit .env.

# Secret salt for HMAC-hashing author IDs. Generate once and NEVER change it
# during a project, or the same author will get different anonymous IDs:
#   python -c "import secrets; print(secrets.token_hex(32))"
ANON_SALT=

# --- YouTube Data API v3 (Google Cloud Console > APIs & Services > Credentials > API key)
YOUTUBE_API_KEY=

# --- Facebook Graph API
# Token with Page Public Content Access (app review) or a Page access token for
# pages you manage. Long-lived tokens recommended.
FACEBOOK_ACCESS_TOKEN=

# --- Instagram Graph API (requires an Instagram Business/Creator account linked to a Facebook Page)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- TikTok Research API (approved academic researchers only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
